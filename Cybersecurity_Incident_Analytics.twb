      <aliases enabled='yes' />
      <column caption='SLA Status' datatype='string' name='[Calculation_0588297871765507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [response_hours] &lt;= [Parameters].[Parameter 0588297869717505] THEN &quot;Met&quot;&#13;&#10;ELSE &quot;Breached&quot;&#13;&#10;END' />
      </column>
      <column caption='Severity' datatype='string' name='[Calculation_0588297872019460]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [impact_score] &gt;= 9 OR [incident_type] = &quot;Ransomware&quot; THEN &quot;Critical&quot;&#13;&#10;ELSEIF [impact_score] &gt;= 7 THEN &quot;High&quot;&#13;&#10;ELSEIF [impact_score] &gt;= 4 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Risk Score' datatype='real' name='[Calculation_0588297872236549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([incident_id]) * AVG([impact_score]) * AVG([criticality]) / 10' />
      </column>
