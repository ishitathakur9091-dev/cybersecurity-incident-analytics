          <datasource-dependencies datasource='federated.1jp43fe0g2njjz18k903k0rxc2o5'>
            <column caption='Risk Score' datatype='real' name='[Calculation_0588297872236549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([incident_id]) * AVG([impact_score]) * AVG([criticality]) / 10' />
            </column>
            <column caption='Criticality' datatype='integer' name='[criticality]' role='measure' type='quantitative' />
            <column caption='Impact Score' datatype='integer' name='[impact_score]' role='measure' type='quantitative' />
            <column caption='Incident Id' datatype='integer' name='[incident_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0588297872236549]' derivation='User' name='[usr:Calculation_0588297872236549:qk]' pivot='key' type='quantitative' />
